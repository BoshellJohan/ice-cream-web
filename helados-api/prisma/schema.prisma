generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STAFF
  ADMIN
}

enum ProductType {
  CONE
  CONTAINER
  BEVERAGE
}

enum ProductSize {
  SMALL
  MEDIUM
  LARGE
  OZ4
  OZ5
  OZ6
  OZ7
  OZ8
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum ToppingType {
  NORMAL
  PREMIUM
}

enum SnapshotPeriod {
  MORNING
  NIGHT
}

enum PaymentMethod {
  QR
  CASH
}

enum CancelReason {
  REGISTRO_ERRONEO
  CLIENTE_CANCELO
  PRODUCTO_DEFECTUOSO
  OTRO
}

model User {
  id              String                @id @default(uuid())
  name            String
  email           String                @unique
  passwordHash    String
  role            Role                  @default(STAFF)
  active          Boolean               @default(true)
  createdAt       DateTime              @default(now())
  orders          Order[]               @relation("OrderStaff")
  cancelledOrders Order[]               @relation("OrderCancelledBy")
  snapshots       InventorySnapshot[]
  inventoryEdits  InventoryEdit[]
  reconciliations DailyReconciliation[]
}

model Product {
  id                  String          @id @default(uuid())
  name                String
  type                ProductType
  size                ProductSize?
  basePrice           Decimal         @db.Decimal(10, 2)
  imageUrl            String?
  active              Boolean         @default(true)
  directSale          Boolean         @default(false)
  includedToppingType ToppingType?
  includedToppingQty  Int?
  createdAt           DateTime        @default(now())
  orderItems          OrderItem[]
  inventoryLines      InventoryLine[]
}

model Flavor {
  id            String      @id @default(uuid())
  name          String
  priceModifier Decimal     @default(0) @db.Decimal(10, 2)
  imageUrl      String?
  active        Boolean     @default(true)
  orderItems    OrderItem[]
}

model ToppingTypeConfig {
  type      ToppingType @id
  unitPrice Decimal     @db.Decimal(10, 2)
}

model Topping {
  id                String             @id @default(uuid())
  name              String
  type              ToppingType        @default(NORMAL)
  customPrice       Decimal?           @db.Decimal(10, 2)
  unitPrice         Decimal            @db.Decimal(10, 2)
  imageUrl          String?
  active            Boolean            @default(true)
  orderItemToppings OrderItemTopping[]
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2)
  maxUses       Int?
  usesCount     Int          @default(0)
  validFrom     DateTime?
  validUntil    DateTime?
  active        Boolean      @default(true)
  orders        Order[]
}

model Order {
  id             String         @id @default(uuid())
  staffId        String
  staff          User           @relation("OrderStaff", fields: [staffId], references: [id])
  couponId       String?
  coupon         Coupon?        @relation(fields: [couponId], references: [id])
  createdAt      DateTime       @default(now())
  payments       OrderPayment[]
  subtotal       Decimal        @db.Decimal(10, 2)
  discountAmount Decimal        @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal        @db.Decimal(10, 2)
  notes          String?
  items          OrderItem[]

  cancelledAt     DateTime?
  cancelledBy     String?
  cancelledByUser User?         @relation("OrderCancelledBy", fields: [cancelledBy], references: [id])
  cancelReason    CancelReason?
}

model OrderPayment {
  id            String        @id @default(uuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentMethod PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)

  @@index([orderId])
}

model OrderItem {
  id        String             @id @default(uuid())
  orderId   String
  order     Order              @relation(fields: [orderId], references: [id])
  productId String
  product   Product            @relation(fields: [productId], references: [id])
  flavorId  String?
  flavor    Flavor?            @relation(fields: [flavorId], references: [id])
  itemTotal Decimal            @db.Decimal(10, 2)
  toppings  OrderItemTopping[]
}

model OrderItemTopping {
  id              String    @id @default(uuid())
  orderItemId     String
  orderItem       OrderItem @relation(fields: [orderItemId], references: [id])
  toppingId       String
  topping         Topping   @relation(fields: [toppingId], references: [id])
  quantity        Int
  unitPriceAtSale Decimal   @db.Decimal(10, 2)
}

model InventorySnapshot {
  id      String          @id @default(uuid())
  takenBy String
  user    User            @relation(fields: [takenBy], references: [id])
  takenAt DateTime        @default(now())
  period  SnapshotPeriod
  notes   String?
  lines   InventoryLine[]
  edits   InventoryEdit[]
}

model InventoryLine {
  id          String            @id @default(uuid())
  snapshotId  String
  snapshot    InventorySnapshot @relation(fields: [snapshotId], references: [id])
  productType ProductType?
  productSize ProductSize?
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id])
  label       String?
  quantity    Decimal           @db.Decimal(10, 2)
}

model InventoryEdit {
  id         String            @id @default(uuid())
  snapshotId String
  snapshot   InventorySnapshot @relation(fields: [snapshotId], references: [id])
  editedBy   String
  user       User              @relation(fields: [editedBy], references: [id])
  editedAt   DateTime          @default(now())
  reason     String?
}

model DailyReconciliation {
  id         String   @id @default(uuid())
  date       DateTime @unique @db.Date
  actualCash Decimal  @db.Decimal(10, 2)
  actualQr   Decimal  @db.Decimal(10, 2)
  updatedBy  String
  user       User     @relation(fields: [updatedBy], references: [id])
  updatedAt  DateTime @updatedAt
}
