# =============================================================
#  Plantilla de variables de entorno de helados-api
#  Cópiala a `.env` y rellena los valores:  cp .env.example .env
#  `.env` está en .gitignore y nunca debe subirse al repositorio.
# =============================================================

# --- Base de datos ---
# Local (docker-compose): postgresql://USUARIO:CONTRASENA@localhost:5432/helados_dev
# Producción: cadena de conexión de Neon
DATABASE_URL=

# --- Autenticación ---
# Cadena aleatoria larga. Genera una con: openssl rand -base64 32
JWT_SECRET=

# --- Servidor ---
PORT=3000
FRONTEND_URL=http://localhost:4200

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Seed del usuario administrador inicial ---
# Sin SEED_ADMIN_PASSWORD el script `npm run prisma:seed` falla a propósito.
SEED_ADMIN_EMAIL=admin@helados.com
SEED_ADMIN_PASSWORD=
